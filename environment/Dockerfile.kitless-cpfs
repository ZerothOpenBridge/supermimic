# Deployment recipe derived from pinned IsaacLab Dockerfile.kitless and zita/docker/Dockerfile.
# Consolidates metadata layers for the isolated VFS store on CPFS. Source and uv.lock are unchanged.
FROM ghcr.io/astral-sh/uv:0.12.9@sha256:8b940d3a9d65bed080436972241af2e21c84b5e8c9193f7014ed71479ee795ff AS uv
FROM public.ecr.aws/ubuntu/ubuntu:24.04 AS builder
ENV ISAACLAB_PATH=/workspace/isaaclab DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 \
    VIRTUAL_ENV=/opt/isaaclab-venv UV_PROJECT_ENVIRONMENT=/opt/isaaclab-venv \
    PATH=/opt/isaaclab-venv/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    UV_PYTHON=/usr/bin/python3.12 UV_PYTHON_PREFERENCE=only-system UV_NO_CACHE=1 \
    PIP_RETRIES=12 UV_HTTP_RETRIES=12
COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /workspace/isaaclab
COPY . .
ARG DEP_PROXY
RUN apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates cmake git libglib2.0-0 python3 python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's@https://files.pythonhosted.org@https://pypi.tuna.tsinghua.edu.cn@g' uv.lock \
    && uv venv --seed "$VIRTUAL_ENV" \
    && HTTPS_PROXY="$DEP_PROXY" NO_PROXY=pypi.nvidia.com,pypi.nvidia.cn,pypi.tuna.tsinghua.edu.cn,download.pytorch.org,download-r2.pytorch.org uv sync --frozen --inexact --extra all --extra importers --extra test \
    && chmod -R a+rwX /opt/isaaclab-venv/lib/python3.*/site-packages/ovrtx \
    && python -c "import importlib.metadata as m; n={d.metadata['Name'].lower() for d in m.distributions()}; assert 'isaacsim' not in n; assert {'isaacsim-asset-isolated','ovphysx','ovrtx','viser','rerun-sdk'} <= n"
FROM public.ecr.aws/ubuntu/ubuntu:24.04 AS runtime
ENV ISAACLAB_PATH=/workspace/isaaclab LANG=C.UTF-8 DEBIAN_FRONTEND=noninteractive \
    HOME=/root VIRTUAL_ENV=/opt/isaaclab-venv UV_PROJECT_ENVIRONMENT=/opt/isaaclab-venv \
    PATH=/opt/isaaclab-venv/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    UV_PYTHON=/usr/bin/python3.12 UV_PYTHON_PREFERENCE=only-system UV_NO_SYNC=1 \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git curl wget libegl1 libgl1 libglib2.0-0 libgomp1 libopengl0 libpython3.12 libvulkan1 libx11-6 libxext6 libxrender1 python3 python3-dev tmux ffmpeg util-linux build-essential fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && printf '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}\n' > /usr/share/glvnd/egl_vendor.d/10_nvidia.json
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/
COPY --from=builder /opt/isaaclab-venv /opt/isaaclab-venv
COPY --from=builder /workspace/isaaclab /workspace/isaaclab
WORKDIR /workspace/supermimic
CMD ["bash"]
